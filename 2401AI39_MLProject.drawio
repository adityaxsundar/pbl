  <diagram id="soh_poster_2401ai39" name="WD-GPR-SR Battery SOH Poster">
    <mxGraphModel dx="1355" dy="934" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1180" background="#F8FAFC" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#1ba1e2;strokeColor=#006EAF;strokeWidth=2;shadow=1;gradientDirection=south;fontColor=#ffffff;" value="" vertex="1">
          <mxGeometry height="135" width="1760" x="20" y="15" as="geometry" />
        </mxCell>
        <mxCell id="4" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=light-dark(#000000,#FFFFFF);" value="&lt;div align=&quot;center&quot;&gt;&lt;font style=&quot;font-size: 24px; letter-spacing: 0.5px;&quot;&gt;&lt;b&gt;WD-GPR-SR: High-Precision Battery State of Health Prediction&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;div style=&quot;margin-top:6px;&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;b&gt;Aditya Sundar&lt;/b&gt; &amp;nbsp;•&amp;nbsp; &lt;b&gt;2401AI39&lt;/b&gt; &amp;nbsp;•&amp;nbsp; Machine Learning&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;Project Based Learning (PBL) &amp;nbsp;|&amp;nbsp; Oxford Battery Suite &amp;nbsp;|&amp;nbsp; Target Edge Hardware: NVIDIA Jetson Orin Nano&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="1420" x="160" y="27" as="geometry" />
        </mxCell>
        <mxCell id="6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;spacingBottom=12;" value="" vertex="1">
          <mxGeometry height="195" width="565" x="20" y="165" as="geometry" />
        </mxCell>
        <mxCell id="7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1E293B;strokeColor=#0F172A;strokeWidth=1;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;shadow=0;" value="1. PROBLEM STATEMENT &amp; MOTIVATION" vertex="1">
          <mxGeometry height="30" width="565" x="20" y="165" as="geometry" />
        </mxCell>
        <mxCell id="8" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;div style=&quot;font-size: 11px; line-height: 1.45; color: rgb(30, 41, 59);&quot;&gt;&lt;b&gt;State of Health (SOH) Formulation:&lt;/b&gt;&lt;br&gt;$$\text{SOH} (\%) = \frac{Q_{\text{usable}}(t)}{Q_{\text{nominal}}} \times 100\%$$• &lt;b&gt;End-of-Life (EOL) Threshold:&lt;/b&gt; In Electric Vehicles, reaching &lt;b&gt;70%–80% SOH&lt;/b&gt; necessitates battery retirement to prevent mid-journey stalling or thermal failure.&lt;br&gt;• &lt;b&gt;The Non-Linear Knee Point:&lt;/b&gt; Passivation SEI(Solid Electrolyte Interphase) growth shifts abruptly into accelerated active material loss and dangerous lithium plating.&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="155" width="541" x="32" y="201" as="geometry" />
        </mxCell>
        <mxCell id="9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;spacingBottom=12;" value="" vertex="1">
          <mxGeometry height="185" width="565" x="20" y="375" as="geometry" />
        </mxCell>
        <mxCell id="10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1E293B;strokeColor=#0F172A;strokeWidth=1;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;shadow=0;" value="2. LIMITATIONS OF EXISTING PARADIGMS" vertex="1">
          <mxGeometry height="30" width="565" x="20" y="375" as="geometry" />
        </mxCell>
        <mxCell id="11" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;div style=&quot;font-size: 11px; line-height: 1.45; color: rgb(30, 41, 59);&quot;&gt;&lt;b&gt;1. Physics Models (P2D / ECM):&lt;/b&gt;&lt;br&gt;− Coupled non-linear PDEs require continuous internal parameter calibration.&lt;br&gt;− Heavy computational overhead prevents real-time 100 Hz BMS execution.&lt;br&gt;&lt;b&gt;2. Pure Deep Learning Models (LSTM, GRU, Transformers):&lt;/b&gt;&lt;br&gt;− Black-box opacity violates automotive safety standards (ISO 26262).&lt;br&gt;− Yield uncalibrated point estimates without confidence bounds.&lt;br&gt;&lt;b&gt;3. Standard Gaussian Process Regression (GPR):&lt;/b&gt;&lt;br&gt;− O(N^3) computational scaling leads to memory exhaustion on streaming cycles.&lt;/div&gt;" vertex="1">
          <mxGeometry height="145" width="541" x="32" y="411" as="geometry" />
        </mxCell>
        <mxCell id="12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#0050ef;strokeColor=#001DBC;strokeWidth=2;fontColor=#ffffff;fontStyle=0;fontSize=11;align=center;verticalAlign=middle;spacing=10;shadow=1;" value="&lt;b&gt;CENTRAL RESEARCH BOTTLENECK &amp;amp; OBJECTIVE:&lt;/b&gt;&lt;br&gt;Safety-critical Battery Management Systems demand BOTH rigorous 95% Bayesian confidence bounds and an auditable closed-form mathematical equation that executes in sub-millisecond time on edge microcontrollers. Neither pure deep learning nor standard physics models fulfill both. &lt;b&gt;WD-GPR-SR bridges this gap!&lt;/b&gt;" vertex="1">
          <mxGeometry height="90" width="565" x="20" y="575" as="geometry" />
        </mxCell>
        <mxCell id="13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;spacingBottom=12;" value="" vertex="1">
          <mxGeometry height="309.77" width="565" x="20" y="680" as="geometry" />
        </mxCell>
        <mxCell id="14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1E293B;strokeColor=#0F172A;strokeWidth=1;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;shadow=0;" value="3. OXFORD DATASET &amp; FEATURE EXTRACTION" vertex="1">
          <mxGeometry height="30" width="565" x="20" y="680" as="geometry" />
        </mxCell>
        <mxCell id="15" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#f5f5f5;gradientColor=#b3b3b3;strokeColor=#666666;" value="&lt;div style=&quot;font-size: 11px; line-height: 1.4;&quot;&gt;&lt;span&gt;&lt;b&gt;Oxford Battery Suite:&lt;/b&gt; 8 Kokam 740 mAh lithium pouch cells tested under Artemis urban drive cycles at 40°C. Characterization curves yield &lt;b&gt;8 Health Indicators (HIs):&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;/span&gt;&lt;table width=&quot;100%&quot; border=&quot;1&quot; cellspacing=&quot;0&quot; cellpadding=&quot;3&quot; style=&quot;font-size: 10px; border-collapse: collapse; border-color: rgb(203, 213, 225);&quot;&gt;&lt;tbody&gt;&lt;tr bgcolor=&quot;#E2E8F0&quot;&gt;&lt;th&gt;&lt;span&gt;HI Symbol&lt;/span&gt;&lt;/th&gt;&lt;th&gt;&lt;span&gt;Feature Name&lt;/span&gt;&lt;/th&gt;&lt;th&gt;&lt;span&gt;Electrochemical Physics Significance&lt;/span&gt;&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;CCCT&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;Const. Current Charge Time&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;Polarization kinetics; drops as internal resistance grows&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr bgcolor=&quot;#F8FAFC&quot;&gt;&lt;td&gt;&lt;b&gt;CVCT&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;Const. Voltage Charge Time&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;Solid-state diffusion relaxation; rises with degradation&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;R&lt;sub&gt;0&lt;/sub&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;Ohmic Resistance&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;Electrolyte breakdown, SEI film thickening&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr bgcolor=&quot;#F8FAFC&quot;&gt;&lt;td&gt;&lt;b&gt;Cycle&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;Cycle Number&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;Cumulative macroscopic usage count&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;ΔT&lt;sub&gt;rise&lt;/sub&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;Temperature Rise&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;Joule heating dissipation during charging&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr bgcolor=&quot;#F8FAFC&quot;&gt;&lt;td&gt;&lt;b&gt;T&lt;sub&gt;max&lt;/sub&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;Peak Temperature&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;Peak operating temperature under 40°C ambient&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;IC V&lt;sub&gt;peak&lt;/sub&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;IC Peak Voltage&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;Cathode/anode phase transition voltage shift&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr bgcolor=&quot;#F8FAFC&quot;&gt;&lt;td&gt;&lt;b&gt;IC H&lt;sub&gt;peak&lt;/sub&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;IC Peak Height&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;Loss of active lithium inventory (LLI tracking)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="255" width="541" x="32" y="720" as="geometry" />
        </mxCell>
        <mxCell id="20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;spacingBottom=12;" value="" vertex="1">
          <mxGeometry height="255" width="575" x="610" y="165" as="geometry" />
        </mxCell>
        <mxCell id="21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1E293B;strokeColor=#0F172A;strokeWidth=1;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;shadow=0;" value="4. PROPOSED WD-GPR-SR ARCHITECTURE" vertex="1">
          <mxGeometry height="30" width="575" x="610" y="165" as="geometry" />
        </mxCell>
        <mxCell id="22" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1.5;align=center;" value="Input Features: &lt;span&gt;\(x \in \mathbb{R}^8\)&lt;/span&gt; (8 Health Indicators)" vertex="1">
          <mxGeometry height="55" width="135" x="628" y="209" as="geometry" />
        </mxCell>
        <mxCell id="23" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;align=center;" value="&lt;b&gt;Wide Linear Branch&lt;/b&gt;&lt;br&gt;$$W^T x + b$$&lt;br&gt;&lt;font size=&#39;1&#39;&gt;Anchors Linear Prior&lt;/font&gt;" vertex="1">
          <mxGeometry height="55" width="145" x="825" y="209" as="geometry" />
        </mxCell>
        <mxCell id="24" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=1.5;align=center;" value="Deep Feature Extractor: MLP (8 → 32 → 16 → 4), Latent: &lt;span&gt;\(\phi(x)\in\mathbb{R}^4\)&lt;/span&gt;" vertex="1">
          <mxGeometry height="55" width="145" x="827.5" y="290" as="geometry" />
        </mxCell>
        <mxCell id="25" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;align=center;" value="Sparse Variational GP: 35 Inducing Points (&lt;span&gt;\(M=35\)&lt;/span&gt;), ARD Matérn 5/2 Kernel, Output: &lt;span&gt;\(\mathcal{N}(\mu_{\text{WD}}, \sigma_{\text{WD}}^2)\)&lt;/span&gt;" vertex="1">
          <mxGeometry height="75" width="150" x="1015" y="240" as="geometry" />
        </mxCell>
        <mxCell id="26" edge="1" parent="1" source="22" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2563EB;strokeWidth=2;endArrow=classic;" target="23" value="" vertex="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="27" edge="1" parent="1" source="22" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2563EB;strokeWidth=2;endArrow=classic;" target="24" value="" vertex="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="695.5" y="310" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="28" edge="1" parent="1" source="23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#D97706;strokeWidth=2;endArrow=classic;" target="25" value="" vertex="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="29" edge="1" parent="1" source="24" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9333EA;strokeWidth=2;endArrow=classic;" target="25" value="" vertex="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="30" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;div style=&quot;font-size: 10px; line-height: 1.35; color: rgb(51, 65, 85);&quot;&gt;• &lt;b&gt;Wide Linear Anchor:&lt;/b&gt; Prevents deep GP variance from exploding in sparse extrapolation zones.&lt;br&gt;• &lt;b&gt;Deep Representation:&lt;/b&gt; Uncovers high-order non-linear thermal-impedance coupling manifold.&lt;br&gt;• &lt;b&gt;Inducing Points (M=35):&lt;/b&gt;&amp;nbsp;Reduces computational complexity from &lt;span&gt;\(\mathcal{O}(N^3)\)&lt;/span&gt; to &lt;span&gt;\(\mathcal{O}(NM^2)\)&lt;/span&gt;.&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="547" x="624" y="350" as="geometry" />
        </mxCell>
        <mxCell id="31" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;spacingBottom=12;" value="" vertex="1">
          <mxGeometry height="405" width="575" x="610" y="435" as="geometry" />
        </mxCell>
        <mxCell id="32" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1E293B;strokeColor=#0F172A;strokeWidth=1;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;shadow=0;" value="5. UNCERTAINTY-WEIGHTED SYMBOLIC CORRECTION" vertex="1">
          <mxGeometry height="30" width="575" x="610" y="435" as="geometry" />
        </mxCell>
        <mxCell id="33" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;div style=&quot;line-height: 1.4; color: rgb(30, 41, 59);&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Precision-Weighted Genetic Programming: Residuals: \(e_i=y_i-\mu_{\text{WD}}(x_i)\), Weighted Loss: \(w_i=\frac{1}{\sigma_{\text{WD}}^2(x_i)+\epsilon}\), Objective: \(\mathcal{J}(r)=\frac{1}{N}\sum_{i=1}^{N}\tilde{w}_i(e_i-r(x_i))^2+\lambda\,\text{Length}(r)\)&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="55" width="551" x="622" y="471" as="geometry" />
        </mxCell>
        <mxCell id="34" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#78350F;fontSize=11;align=center;verticalAlign=middle;spacing=6;shadow=1;" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b style=&quot;&quot;&gt;DISCOVERED CLOSED-FORM RESIDUAL EQUATION:&lt;/b&gt;&lt;br&gt;\[&lt;br&gt;\boxed{&lt;br&gt;r(x)=0.045\sin(x_{\text{CCCT}})\cos(x_{\text{res}})&lt;br&gt;-0.032\ln(|x_{\text{CVCT}}|+1)&lt;br&gt;-0.025x_{\text{cycle}}&lt;br&gt;}&lt;br&gt;\]&lt;/font&gt;" vertex="1">
          <mxGeometry height="99" width="551" x="622" y="588" as="geometry" />
        </mxCell>
        <mxCell id="35" parent="1" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/jpeg;base64,;" value="" vertex="1">
          <mxGeometry height="145" width="300" x="626" y="590" as="geometry" />
        </mxCell>
        <mxCell id="36" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;div style=&quot;line-height: 1.35; color: rgb(30, 41, 59);&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;p style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Exact Analytical Sensitivities: CCCT: \(0.045\cos(x_1)\cos(x_3)\), Resistance: \(-0.045\sin(x_1)\sin(x_3)\), CVCT: \(\frac{-0.032\,\text{sgn}(x_2)}{|x_2|+1.0}\), Cycle: \(-0.025\). Thermal and IC derivatives: \(\leq 0.0015\), indicating degradation is primarily driven by charge duration and resistance.&lt;/font&gt;&lt;/p&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 10px;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 10px;&quot;&gt;&lt;div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 10px;&quot;&gt;&lt;div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="551" x="624" y="700" as="geometry" />
        </mxCell>
        <mxCell id="37" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;spacingBottom=12;" value="" vertex="1">
          <mxGeometry height="325" width="575" x="610" y="860" as="geometry" />
        </mxCell>
        <mxCell id="38" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1E293B;strokeColor=#0F172A;strokeWidth=1;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;shadow=0;" value="6. MATHEMATICAL FORMULATION: SVGP ELBO" vertex="1">
          <mxGeometry height="30" width="575" x="610" y="860" as="geometry" />
        </mxCell>
        <mxCell id="39" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;div style=&quot;line-height: 1.45; color: rgb(30, 41, 59);&quot;&gt;&lt;p style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;Variational GP (ELBO): Optimizes \(\mathcal{L}_{\text{ELBO}}=\sum_{i=1}^{N}\mathbb{E}_{q(f_i)}[\ln p(y_i|f_i)]-\mathrm{KL}(q(u)\|p(u))\), with \(q(u)=\mathcal{N}(m,S)\), \(M=35\) inducing points.&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;ARD Matérn 5/2 Kernel: &lt;span&gt;\(k(z,z&#39;)=\sigma_f^2(1+\sqrt{5}d+\frac{5}{3}d^2)e^{-\sqrt{5}d}\)&lt;/span&gt;, where &lt;span&gt;\(d=\sqrt{\sum_{j=1}^{4}\frac{(z_j-z&#39;_j)^2}{\ell_j^2}}\)&lt;/span&gt;.&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;Final Prediction: \(\hat y_{\text{final}}(x)=\mu_{\text{WD}}(x)+r(x)\pm1.96\sigma_{\text{WD}}(x)\).&lt;/font&gt;&lt;/p&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="225" width="551" x="621" y="908" as="geometry" />
        </mxCell>
        <mxCell id="40" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;spacingBottom=12;" value="" vertex="1">
          <mxGeometry height="175" width="570" x="20" y="1010" as="geometry" />
        </mxCell>
        <mxCell id="41" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1E3A8A;strokeColor=#172554;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;" value="THEORETICAL NOVELTY &amp; BREAKTHROUGH" vertex="1">
          <mxGeometry height="28" width="570" x="20" y="1010" as="geometry" />
        </mxCell>
        <mxCell id="42" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;div style=&#39;font-size:11px; line-height:1.45; color:#1E293B;&#39;&gt;&amp;bull; &lt;b&gt;Variance Regularization:&lt;/b&gt; In ablation experiments, removing the wide linear branch caused NLL to explode from &lt;b&gt;-2.073 to +1.637&lt;/b&gt;. The wide prior acts as a critical physical anchor in dynamic cycling.&lt;br&gt;&amp;bull; &lt;b&gt;Auditable Transparency:&lt;/b&gt; Automotive safety certification bodies (ISO 26262) reject pure black-box deep nets. WD-GPR-SR provides a human-readable closed-form equation inspectable with standard calculus.&lt;/div&gt;" vertex="1">
          <mxGeometry height="135" width="551" x="32" y="1046" as="geometry" />
        </mxCell>
        <mxCell id="43" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;spacingBottom=12;" value="" vertex="1">
          <mxGeometry height="355" width="570" x="1210" y="165" as="geometry" />
        </mxCell>
        <mxCell id="44" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1E293B;strokeColor=#0F172A;strokeWidth=1;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;shadow=0;" value="7. BENCHMARK &amp; CROSS-CELL VALIDATION" vertex="1">
          <mxGeometry height="30" width="570" x="1210" y="165" as="geometry" />
        </mxCell>
        <mxCell id="48" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;spacingBottom=12;" value="" vertex="1">
